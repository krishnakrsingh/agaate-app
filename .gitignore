cookies.txt
server.log
/public/uploads/

# generated files and OS noise
*.tsbuildinfo
npm-debug.log*

# test results and reports
/test-results
/playwright-report
/blob-report

# graphify cache
/graphify-out/cache/

# auto-commit loop
auto-commit-loop.ps1

