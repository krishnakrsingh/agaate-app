generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  FARM_ADMIN
  AGRONOMIST
  FARM_OFFICER
}

enum FarmStatus {
  SETUP
  ACTIVE
  INACTIVE
  COMPLETED
}

enum FarmSetupStage {
  SURVEY_SOIL_TEST
  PLOT_DEMARCATION
  BED_SOIL_PREP
  IRRIGATION_LAYOUT
  HANDED_OVER
}

enum PlotStatus {
  SETUP
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EstablishmentType {
  NURSERY_TRANSPLANTATION
  DIRECT_SOWING
}

enum CropCycleStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskOrigin {
  AGRONOMIST
  SYSTEM
  DAILY_MONITORING
}

enum TaskStatus {
  DRAFT
  ASSIGNED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  BLOCKED
}

enum AttendanceStatus {
  OPEN
  COMPLETED
  EXCEPTION_PENDING
  EXCEPTION_APPROVED
  EXCEPTION_REJECTED
}

enum GeofenceBasis {
  PLOT_POLYGON
  FARM_POLYGON
  RADIUS
}

enum BoundaryEntityType {
  FARM
  PLOT
}

enum BoundarySource {
  MANUAL_DRAW
  GPS_WALK
  GRID_SPLIT
  LEGACY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HealthStatus {
  GOOD
  POOR
}

enum IncidentLevel {
  FARM
  PLOT
  CROP
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

enum MediaKind {
  SELFIE
  CROP_PHOTO
  INCIDENT_PHOTO
  ACTIVITY_EVIDENCE
}

model Client {
  id          String   @id @default(cuid())
  code             String?  @unique
  name             String
  email            String?  @unique
  phone            String?  @unique
  companyName      String?
  entityType       String?  // INDIVIDUAL, PVT_LTD, PARTNERSHIP, HUF, TRUST
  panNumber        String?
  gstin            String?
  billingAddress   String?
  secondaryContact String?
  state            String?
  district         String?
  address          String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  farms            Farm[]
  users            User[]

  @@index([status])
  @@index([state, district])
  @@index([createdAt])
  @@index([status, createdAt])
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  phone                 String?                @unique
  dateOfBirth           DateTime?              @db.Date
  isSupervisor          Boolean                @default(false)
  passwordHash          String
  role                  Role
  active                Boolean                @default(true)
  clientId              String?
  client                Client?                @relation(fields: [clientId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  farmAccess            FarmAccess[]
  assignedTasks         Task[]                 @relation("AssignedOfficer")
  createdTasks          Task[]                 @relation("TaskCreator")
  createdPlans          AgronomyPlan[]         @relation("PlanCreator")
  executions            TaskExecution[]
  attendance            Attendance[]
  monitoring            CropMonitoring[]
  reportedIncidents     Incident[]             @relation("IncidentReporter")
  incidentFollowUps     IncidentFollowUp[]     @relation("FollowUpAuthor")
  auditLogs             AuditLog[]             @relation("AuditActor")
  harvestLogs           HarvestLog[]
  expenseLogs           ExpenseLog[]
  crewMusters           DailyCrewMuster[]
  authoredPrescriptions AgronomyPrescription[]

  @@index([role, active])
  @@index([clientId])
}

model Farm {
  id                     String                  @id @default(cuid())
  clientId               String?
  client                 Client?                 @relation(fields: [clientId], references: [id])
  name                   String
  ownerName              String
  location               String
  address                String?
  latitude               Decimal                 @db.Decimal(10, 7)
  longitude              Decimal                 @db.Decimal(10, 7)
  totalArea              Decimal                 @db.Decimal(12, 2)
  cultivableArea         Decimal                 @db.Decimal(12, 2)
  waterSource            String
  soilType               String?
  surveyNumber           String?                 // Khasra / Patta / Survey No.
  village                String?
  taluk                  String?
  district               String?
  state                  String?
  pincode                String?
  terrainType            String?                 // Flat Plain, Gentle Gradient, Rolling Hills, Terraced
  fencingType            String?                 // Chainlink, Barbed Wire, Solar Electric, Stone Wall
  borewellCount          Int?
  borewellDepthFeet      Int?
  waterYieldGph          Int?
  electricitySupply      String?                 // 3-Phase Agri, Solar Pump, Grid-tied
  soilPh                 Decimal?                @db.Decimal(4, 2)
  soilEc                 Decimal?                @db.Decimal(4, 2)
  soilOrganicCarbon      Decimal?                @db.Decimal(4, 2)
  proposedCrops          String?
  contractValue          Decimal?                @db.Decimal(14, 2)
  targetHandoverDate     DateTime?
  boundaryGeoJson        String?                 @db.Text
  measuredAcres          Decimal?              @db.Decimal(12, 2)
  clientPhone            String?
  clientDob              DateTime?               @db.Date
  status                 FarmStatus              @default(SETUP)
  setupStage             FarmSetupStage          @default(SURVEY_SOIL_TEST)
  setupProgress          Int                     @default(0)
  handedOverAt           DateTime?
  geofenceRadiusMeters   Int                     @default(500)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  access                 FarmAccess[]
  plots                  Plot[]
  tasks                  Task[]
  attendance             Attendance[]
  incidents              Incident[]
  monitoring             CropMonitoring[]
  locationChangeRequests LocationChangeRequest[]
  agronomyPlans          AgronomyPlan[]
  harvestLogs            HarvestLog[]
  inventoryItems         InventoryItem[]
  expenseLogs            ExpenseLog[]
  crewMusters            DailyCrewMuster[]
  prescriptions          AgronomyPrescription[]

  @@index([status])
  @@index([setupStage])
  @@index([name])
  @@index([clientId, status])
  @@index([clientId])
  @@index([state, district])
  @@index([setupStage, status])
  @@index([createdAt])
  @@index([updatedAt])
}

model FarmAccess {
  id        String   @id @default(cuid())
  userId    String
  farmId    String
  canManage Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([userId, farmId])
  @@index([farmId])
}

model Plot {
  id            String                    @id @default(cuid())
  farmId        String
  name          String
  area          Decimal                   @db.Decimal(12, 2)
  latitude      Decimal                   @db.Decimal(10, 7)
  longitude     Decimal                   @db.Decimal(10, 7)
  soilType      String?
  boundaryGeoJson String?                 @db.Text // canonical GeoJSON Polygon; server-validated within farm
  measuredAcres Decimal?                  @db.Decimal(12, 2) // server-computed from boundary
  captureId     String?                   @unique // perimeter-walk idempotency key (one walk → one plot, ever)
  status        PlotStatus                @default(SETUP)
  deletedAt     DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  farm          Farm                      @relation(fields: [farmId], references: [id])
  irrigation    IrrigationConfiguration[]
  attendance    Attendance[]
  cropCycles    CropCycle[]
  tasks         Task[]
  monitoring    CropMonitoring[]
  incidents     Incident[]
  harvestLogs   HarvestLog[]
  prescriptions AgronomyPrescription[]

  @@unique([farmId, name])
  @@index([farmId, status])
}

model IrrigationConfiguration {
  id      String  @id @default(cuid())
  plotId  String
  type    String
  details String?
  plot    Plot    @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@unique([plotId, type])
}

model CropCycle {
  id                       String                 @id @default(cuid())
  plotId                   String
  cropName                 String
  startDate                DateTime               @db.Date
  expectedFirstHarvestDate DateTime?              @db.Date
  establishmentType        EstablishmentType
  status                   CropCycleStatus        @default(PLANNED)
  bedPreparationEnabled    Boolean                @default(false)
  bedWidthCm               Decimal?               @db.Decimal(8, 2)
  bedCenterDistanceCm      Decimal?               @db.Decimal(8, 2)
  expectedBedsPerAcre      Decimal?               @db.Decimal(12, 2)
  expectedTotalBeds        Decimal?               @db.Decimal(12, 2)
  actualBedsCreated        Decimal?               @db.Decimal(12, 2)
  mulchEnabled             Boolean                @default(false)
  mulchHolePattern         String?
  plantDistanceCm          Decimal?               @db.Decimal(8, 2)
  expectedPlantsPerAcre    Decimal?               @db.Decimal(12, 2)
  expectedPlants           Decimal?               @db.Decimal(12, 2)
  actualPlants             Decimal?               @db.Decimal(12, 2)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  plot                     Plot                   @relation(fields: [plotId], references: [id])
  varieties                CropVariety[]
  milestones               Milestone[]
  tasks                    Task[]
  monitoring               CropMonitoring[]
  incidents                Incident[]
  harvestLogs              HarvestLog[]
  prescriptions            AgronomyPrescription[]

  @@index([plotId, status])
}

model CropVariety {
  id          String    @id @default(cuid())
  cropCycleId String
  name        String
  cropCycle   CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@unique([cropCycleId, name])
}

model Milestone {
  id          String          @id @default(cuid())
  cropCycleId String
  name        String
  targetDate  DateTime        @db.Date
  status      MilestoneStatus @default(PENDING)
  remarks     String?
  completedAt DateTime?
  cropCycle   CropCycle       @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([cropCycleId, targetDate])
}

model AgronomyPlan {
  id                   String   @id @default(cuid())
  farmId               String
  planDate             DateTime @db.Date
  notes                String?
  manualTemperature    Decimal? @db.Decimal(5, 2)
  manualHumidity       Decimal? @db.Decimal(5, 2)
  manualWindSpeed      Decimal? @db.Decimal(5, 2)
  manualRainForecast   Decimal? @db.Decimal(5, 2)
  manualWeatherRemarks String?
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  farm                 Farm     @relation(fields: [farmId], references: [id])
  createdBy            User     @relation("PlanCreator", fields: [createdById], references: [id])
  tasks                Task[]

  @@unique([farmId, planDate])
}

model Task {
  id                String          @id @default(cuid())
  farmId            String
  plotId            String?
  cropCycleId       String?
  milestoneId       String?
  planId            String?
  origin            TaskOrigin
  category          String
  title             String
  description       String
  instructions      String?
  priority          String          @default("MEDIUM")
  dueDate           DateTime        @db.Date
  status            TaskStatus      @default(DRAFT)
  assignedOfficerId String?
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  farm              Farm            @relation(fields: [farmId], references: [id])
  plot              Plot?           @relation(fields: [plotId], references: [id])
  cropCycle         CropCycle?      @relation(fields: [cropCycleId], references: [id])
  milestone         Milestone?      @relation(fields: [milestoneId], references: [id])
  plan              AgronomyPlan?   @relation(fields: [planId], references: [id])
  assignedOfficer   User?           @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  createdBy         User            @relation("TaskCreator", fields: [createdById], references: [id])
  executions        TaskExecution[]

  @@index([assignedOfficerId, dueDate, status])
  @@index([farmId, dueDate])
  @@index([plotId])
  @@index([cropCycleId])
  @@index([status, dueDate])
}

model TaskExecution {
  id          String          @id @default(cuid())
  taskId      String          @unique
  officerId   String
  status      TaskStatus
  startedAt   DateTime?
  completedAt DateTime?
  remarks     String?
  latitude    Decimal?        @db.Decimal(10, 7) // completion GPS (optional evidence)
  longitude   Decimal?        @db.Decimal(10, 7)
  geofenceBasis GeofenceBasis? // which boundary authorized the completion
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  officer     User            @relation(fields: [officerId], references: [id])
  materials   MaterialUsage[]
  labour      LabourUsage[]
  media       MediaAsset[]

  @@index([officerId])
}

model MaterialUsage {
  id           String        @id @default(cuid())
  executionId  String
  materialName String
  quantity     Decimal       @db.Decimal(12, 2)
  unit         String
  execution    TaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model LabourUsage {
  id          String        @id @default(cuid())
  executionId String
  labourers   Int
  hours       Decimal       @db.Decimal(8, 2)
  labourHours Decimal       @db.Decimal(12, 2)
  execution   TaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Attendance {
  id              String               @id @default(cuid())
  userId          String
  farmId          String
  plotId          String?
  attendanceDate  DateTime             @db.Date
  status          AttendanceStatus     @default(OPEN)
  geofenceBasis   GeofenceBasis?
  startAt         DateTime?
  endAt           DateTime?
  startLatitude   Decimal?             @db.Decimal(10, 7)
  startLongitude  Decimal?             @db.Decimal(10, 7)
  endLatitude     Decimal?             @db.Decimal(10, 7)
  endLongitude    Decimal?             @db.Decimal(10, 7)
  startSelfieKey  String?
  endSelfieKey    String?
  exceptionReason String?
  user            User                 @relation(fields: [userId], references: [id])
  farm            Farm                 @relation(fields: [farmId], references: [id])
  plot            Plot?                @relation(fields: [plotId], references: [id])
  exception       AttendanceException?

  @@unique([userId, farmId, attendanceDate])
  @@index([farmId, attendanceDate])
  @@index([plotId])
}

model AttendanceException {
  id             String         @id @default(cuid())
  attendanceId   String         @unique
  distanceMeters Decimal        @db.Decimal(12, 2)
  reason         String
  status         ApprovalStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([status])
}

/**
 * Immutable geometry history. One row per authoritative boundary state.
 * NO foreign keys to Farm/Plot by design: history must survive entity
 * deletion/renames (evidence layer, not relational data). Lookups are
 * (entityType, entityId, version) via the compound unique + index.
 */
model BoundaryVersion {
  id                    String               @id @default(cuid())
  entityType            BoundaryEntityType
  entityId              String
  version               Int
  boundaryGeoJson       String?              @db.Text // null = fence-removed version
  measuredAcres         Decimal?             @db.Decimal(12, 2)
  perimeterM            Decimal?             @db.Decimal(12, 2)
  centroidLat           Decimal?             @db.Decimal(10, 7)
  centroidLng           Decimal?             @db.Decimal(10, 7)
  prevAcres             Decimal?             @db.Decimal(12, 2)
  areaFlagged           Boolean              @default(false) // |Δ| >= policy threshold (advisory)
  source                BoundarySource
  actorId               String? // null = unknown (LEGACY); no FK so history survives user deletion
  actorName             String? // snapshot at write time; renames don't rewrite history
  captureId             String?
  restoredFromVersionId String?
  createdAt             DateTime             @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, version])
  @@index([captureId])
}

/**
 * Retained GPS evidence for walked boundaries. id = client captureId
 * (natural key: redelivery can never duplicate evidence).
 * Small blobs (≤2000 samples, typically <30KB); no indexes on payloads.
 */
model WalkTrack {
  id             String               @id // = captureId
  entityType     BoundaryEntityType
  entityId       String
  rawSamples     Json // fixes exactly as submitted by the device
  cleanedSamples Json // what the server actually used
  samplesKept    Int
  samplesDropped Int
  quality        String // GOOD | WARNING (INVALID never persists)
  acres          Decimal?             @db.Decimal(12, 2)
  actorId        String?
  createdAt      DateTime             @default(now())

  @@index([entityType, entityId])
}

model LocationChangeRequest {
  id                String         @id @default(cuid())
  farmId            String
  requesterId       String
  proposedLatitude  Decimal        @db.Decimal(10, 7)
  proposedLongitude Decimal        @db.Decimal(10, 7)
  reason            String
  status            ApprovalStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  farm              Farm           @relation(fields: [farmId], references: [id])

  @@index([farmId, status])
}

model CropMonitoring {
  id            String       @id @default(cuid())
  farmId        String
  plotId        String
  cropCycleId   String
  officerId     String
  status        HealthStatus
  stage         String
  impactPercent Decimal?     @db.Decimal(5, 2)
  remarks       String?
  latitude      Decimal?       @db.Decimal(10, 7) // optional scouting GPS
  longitude     Decimal?       @db.Decimal(10, 7)
  geofenceBasis GeofenceBasis?
  createdAt     DateTime       @default(now())
  farm          Farm           @relation(fields: [farmId], references: [id])
  plot          Plot           @relation(fields: [plotId], references: [id])
  cropCycle     CropCycle      @relation(fields: [cropCycleId], references: [id])
  officer       User         @relation(fields: [officerId], references: [id])
  media         MediaAsset[]

  @@index([farmId, createdAt])
  @@index([cropCycleId])
  @@index([status])
}

model Incident {
  id            String             @id @default(cuid())
  farmId        String
  plotId        String?
  cropCycleId   String?
  reporterId    String
  level         IncidentLevel
  type          String
  description   String
  severity      String?
  impactPercent Decimal?           @db.Decimal(5, 2)
  status        IncidentStatus     @default(OPEN)
  latitude      Decimal?           @db.Decimal(10, 7) // optional report GPS
  longitude     Decimal?           @db.Decimal(10, 7)
  geofenceBasis GeofenceBasis?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  farm          Farm               @relation(fields: [farmId], references: [id])
  plot          Plot?              @relation(fields: [plotId], references: [id])
  cropCycle     CropCycle?         @relation(fields: [cropCycleId], references: [id])
  reporter      User               @relation("IncidentReporter", fields: [reporterId], references: [id])
  media         MediaAsset[]
  followUps     IncidentFollowUp[]

  @@index([farmId, status])
  @@index([cropCycleId])
}

model IncidentFollowUp {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String
  action     String
  remarks    String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     User     @relation("FollowUpAuthor", fields: [authorId], references: [id])

  @@index([incidentId, createdAt])
}

model MediaAsset {
  id           String          @id @default(cuid())
  storageKey   String          @unique
  kind         MediaKind
  mimeType     String
  sizeBytes    Int
  farmId       String?
  executionId  String?
  monitoringId String?
  incidentId   String?
  uploadedById String
  verifiedAt   DateTime?
  createdAt    DateTime        @default(now())
  execution    TaskExecution?  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  monitoring   CropMonitoring? @relation(fields: [monitoringId], references: [id], onDelete: Cascade)
  incident     Incident?       @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([executionId])
  @@index([monitoringId])
  @@index([incidentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model HarvestLog {
  id            String   @id @default(cuid())
  farmId        String
  plotId        String
  cropCycleId   String
  harvestDate   DateTime @db.Date
  quantity      Decimal  @db.Decimal(12, 2)
  unit          String
  grade         String
  buyerOrMarket String?
  vehicleNumber String?
  pricePerUnit  Decimal? @db.Decimal(10, 2)
  totalAmount   Decimal? @db.Decimal(12, 2)
  notes         String?
  photoKey      String?
  createdById   String
  createdAt     DateTime @default(now())

  farm      Farm      @relation(fields: [farmId], references: [id])
  plot      Plot      @relation(fields: [plotId], references: [id])
  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([farmId, harvestDate])
  @@index([cropCycleId])
}

model InventoryItem {
  id              String   @id @default(cuid())
  farmId          String
  name            String
  category        String
  quantityInStock Decimal  @db.Decimal(12, 2)
  unit            String
  reorderLevel    Decimal? @db.Decimal(12, 2)
  costPerUnit     Decimal? @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt

  farm         Farm                   @relation(fields: [farmId], references: [id])
  transactions InventoryTransaction[]

  @@unique([farmId, name])
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  itemId    String
  type      String
  quantity  Decimal  @db.Decimal(12, 2)
  taskId    String?
  notes     String?
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model ExpenseLog {
  id           String   @id @default(cuid())
  farmId       String
  date         DateTime @db.Date
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  description  String
  receiptKey   String?
  recordedById String
  createdAt    DateTime @default(now())

  farm       Farm @relation(fields: [farmId], references: [id])
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([farmId, date])
  @@index([category])
}

model DailyCrewMuster {
  id             String   @id @default(cuid())
  farmId         String
  musterDate     DateTime @db.Date
  totalLabourers Int
  maleCount      Int?
  femaleCount    Int?
  hoursPerShift  Decimal  @default(8.0) @db.Decimal(4, 2)
  dailyWageRate  Decimal? @db.Decimal(10, 2)
  totalWageCost  Decimal? @db.Decimal(12, 2)
  contractorName String?
  notes          String?
  recordedById   String
  createdAt      DateTime @default(now())

  farm       Farm @relation(fields: [farmId], references: [id])
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@unique([farmId, musterDate])
}

model AgronomyPrescription {
  id              String   @id @default(cuid())
  farmId          String
  plotId          String
  cropCycleId     String
  authorId        String
  targetIssue     String
  recipeDetails   Json
  applicationDate DateTime @db.Date
  instructions    String
  priority        String   @default("HIGH")
  status          String   @default("DISPATCHED")
  createdAt       DateTime @default(now())

  farm      Farm      @relation(fields: [farmId], references: [id])
  plot      Plot      @relation(fields: [plotId], references: [id])
  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])

  @@index([farmId, applicationDate])
  @@index([plotId])
  @@index([cropCycleId])
  @@index([authorId])
}

/**
 * HQ multi-step client onboarding drafts. One row per wizard session,
 * keyed by a client-generated idempotency key so double-saves and
 * double-submits collapse onto the same record. No FK to User by design:
 * drafts must survive account deactivation (same rationale as
 * BoundaryVersion history). Payload is the raw WizardData JSON.
 */
model OnboardingDraft {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  createdById    String
  payload        Json
  resultJson     Json?
  status         String   @default("DRAFT")
  clientName     String?
  farmCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdById, updatedAt])
  @@index([status, updatedAt])
}
